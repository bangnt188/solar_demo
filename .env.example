DEPLOY_TARGET=demo
# Unapproved MVP: mock by default, no provider calls. Cloud is opt-in after scope approval.
INTEGRATION_MODE=mock
# Used by operator scripts. Demo seed/write-smoke require sandbox explicitly.
APP_ENV=sandbox
# Public site URL includes the deployment prefix; changing it requires a rebuild.
# Leave unset for the GitHub Pages demo at https://bangnt188.github.io/solar_demo/.
NEXT_PUBLIC_SITE_URL=
# Keep false for previews/demo. Enable only after domain and content approval.
SEO_INDEXABLE=false

# Production on Vercel only; do not set for GitHub Pages demo.
DATABASE_URL=
# Direct migration-role URI: operator/release only; never set on web runtime.
DATABASE_URL_DIRECT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public HTTPS custom-domain origin, required when published media uses R2.
R2_PUBLIC_BASE_URL=
# Optional jurisdiction endpoint; must belong to R2_ACCOUNT_ID.
R2_ENDPOINT=
# Reserved for later live auth/Sheets implementation; mock does not read these.
AUTH_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
