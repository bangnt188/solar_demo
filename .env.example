# Demo export is the default; only server builds include backend routes.
DEPLOY_TARGET=demo
# Operator scripts require sandbox explicitly before seeding or write-smoke.
APP_ENV=sandbox
# Public site URL includes the deployment prefix; changing it requires a rebuild.
# Leave unset for the GitHub Pages demo at https://bangnt188.github.io/solar_demo/.
NEXT_PUBLIC_SITE_URL=
# Keep false for previews/demo. Enable only after domain and content approval.
SEO_INDEXABLE=false

# Server target only; never set cloud credentials for the GitHub Pages demo.
DATABASE_URL=
# Direct migration-role URI: operator/release only; never set on web runtime.
DATABASE_URL_DIRECT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public HTTPS custom-domain origin for published R2 media.
R2_PUBLIC_BASE_URL=
# Optional jurisdiction endpoint; must belong to R2_ACCOUNT_ID.
R2_ENDPOINT=

# Survey intake stays off; the current client survey remains a demo.
SURVEY_INTAKE_ENABLED=false
# At least 32 bytes, supplied securely only when intake is approved.
SURVEY_RATE_LIMIT_SECRET=
# Required integer 1..10000 when enabled; operator chooses the global budget.
SURVEY_GLOBAL_LIMIT=
TURNSTILE_SECRET_KEY=

# Reserved; auth and Sheets are not activated by backend integration.
AUTH_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
