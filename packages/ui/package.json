{
  "name": "@solar/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["./dist/styles.css"],
  "scripts": {
    "build": "vite build"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./basic": {
      "types": "./dist/types/basic/index.d.ts",
      "import": "./dist/basic.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./forms": {
      "types": "./dist/types/forms/index.d.ts",
      "import": "./dist/forms.js"
    },
    "./validation": {
      "types": "./dist/types/validation/index.d.ts",
      "import": "./dist/validation.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n/index.d.ts",
      "import": "./dist/i18n.js"
    },
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": ">=7",
    "zod": ">=4",
    "@base-ui/react": ">=1"
  },
  "peerDependenciesMeta": {
    "react-hook-form": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.1"
  }
}
