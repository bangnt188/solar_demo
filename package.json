{
  "name": "solar-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/ui",
    "packages/backend"
  ],
  "scripts": {
    "pull": "node scripts/pull-submodules.mjs",
    "build:ui": "npm run build --workspace=@solar/ui",
    "predev": "npm run build:backend && npm run build:ui",
    "dev": "next dev",
    "prebuild": "npm run build:backend && npm run build:ui",
    "build": "node scripts/build-demo.mjs",
    "prebuild:demo": "npm run build:backend && npm run build:ui",
    "build:demo": "node scripts/build-demo.mjs",
    "prebuild:server": "npm run build:backend && npm run build:ui",
    "build:server": "node scripts/next-server.mjs build",
    "predev:server": "npm run build:backend && npm run build:ui",
    "dev:server": "node scripts/next-server.mjs dev",
    "start:server": "node scripts/next-server.mjs start",
    "pretypecheck": "npm run build:backend && npm run build:ui && npm run typecheck:ui && npm run typecheck:backend",
    "typecheck": "tsc --noEmit",
    "test:export": "node --test tests/export.test.mjs",
    "test:core": "node --conditions=react-server --import tsx --test tests/core.test.ts",
    "pretest:integration": "npm run build:backend && npm run build:ui",
    "test:integration": "bash scripts/test-integration.sh",
    "db:migrate": "node --conditions=react-server --import tsx scripts/database.ts migrate",
    "db:seed:sandbox": "node --conditions=react-server --import tsx scripts/database.ts seed",
    "smoke:cloud": "node --conditions=react-server --import tsx scripts/smoke-cloud.ts",
    "pretest:ui": "npm run build:ui",
    "test:ui": "node --import tsx --test packages/ui/tests/*.test.ts packages/ui/tests/*.test.tsx",
    "build:backend": "npm run build --workspace=@shared/backend",
    "typecheck:backend": "npm run typecheck --workspace=@shared/backend",
    "test:backend": "npm run test --workspace=@shared/backend",
    "typecheck:ui": "npm run typecheck --workspace=@solar/ui",
    "check:backend": "npm run check:integrity --workspace=@shared/backend",
    "test:backend:consumer": "npm run build:backend && node --conditions=react-server --import tsx --test tests/backend-consumer.test.ts",
    "pretest:core": "npm run build:backend"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@solar/ui": "0.1.0",
    "@smithy/node-http-handler": "4.12.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "lenis": "1.3.26",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.6.5",
    "@shared/backend": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
